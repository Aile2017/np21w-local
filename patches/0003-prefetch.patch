-#define	cpu_memorywrite_w(a,v)	memp_write16(a,v)
-#define	cpu_memorywrite_d(a,v)	memp_write32(a,v)
+#define	cpu_memorywrite(a,v)	memp_write8(pfq_w(a,1),v)
+#define	cpu_memorywrite_b(a,v)	memp_write8(pfq_w(a,1),v)
+#define	cpu_memorywrite_w(a,v)	memp_write16(pfq_w(a,2),v)
+#define	cpu_memorywrite_d(a,v)	memp_write32(pfq_w(a,4),v)
 #define	cpu_memoryread(a)	memp_read8(a)
 #define	cpu_memoryread_b(a)	memp_read8(a)
 #define	cpu_memoryread_w(a)	memp_read16(a)
@@ -95,10 +117,10 @@
 
 #else
 // 高速版
-#define	cpu_memorywrite(a,v)	memp_write8_fast(a,v)
-#define	cpu_memorywrite_b(a,v)	memp_write8_fast(a,v)
-#define	cpu_memorywrite_w(a,v)	memp_write16_fast(a,v)
-#define	cpu_memorywrite_d(a,v)	memp_write32_fast(a,v)
+#define	cpu_memorywrite(a,v)	memp_write8_fast(pfq_w(a,1),v)
+#define	cpu_memorywrite_b(a,v)	memp_write8_fast(pfq_w(a,1),v)
+#define	cpu_memorywrite_w(a,v)	memp_write16_fast(pfq_w(a,2),v)
